# vLLM/SGlang Router Configuration

# JSON array of backend servers.
# Fields: name (string, required), url (string, required),
#   maxConcurrent (int, 0=unlimited), tier (0=king, 1=subject),
#   gpuWeight (int, GPU cost when tier-0 active),
#   blockOnTier0 (int, block threshold, 0=disabled),
#   maxQueueDepth (int, default 2),
#   maxConcurrentLargePrefill (int, 0=disabled),
#   largePrefillThresholdTokens (int, default 8192)
BACKENDS=[{"name":"example-model","url":"http://vllm:8000","maxConcurrent":4,"tier":0}]

# Maximum time a request waits in queue before returning 429 (default: 30s)
MAX_QUEUE_TIMEOUT=30s

# GPU budget: max weighted GPU usage when tier-0 is active (default: 4)
MAX_GPU_BUDGET=4

# Maximum request body size in bytes (default: 16777216, 16 MiB)
# Previously hardcoded at 1 MiB. Requests exceeding this get HTTP 413.
# MAX_BODY_BYTES=16777216

# Estimated prefill throughput (default: 10000)
# Bounds how long non-streaming requests hold a large-prefill slot.
# PREFILL_TOKENS_PER_SEC=10000

# Session admission: bounded per-backend conversation leases. Off by default;
# off and unkeyed traffic keep the legacy per-request behavior exactly.
# SESSION_ADMISSION=on
# Cap of admitted conversations per backend; empty inherits each backend's
# maxConcurrent (required to be set explicitly for unlimited backends).
# SESSION_MAX_ADMITTED=
# Bounded FIFO admission queue per backend; empty inherits maxQueueDepth.
# SESSION_MAX_WAITING=
# Idle lease retention before a newcomer may take the slot (default 5m).
# SESSION_IDLE_TTL=5m
# Lease identity source: prompt_cache_key (default), user, or header:<Name>.
# SESSION_KEY_SOURCE=prompt_cache_key

# Optional: persist the dashboard's history rings across restarts.
# Point at a writable file on a mounted volume; empty = memory only.
# HISTORY_PATH=/data/history.gob

# Optional: device GPU utilization/VRAM/temperature/power from a Prometheus
# text endpoint (DCGM exporter or nvidia_gpu_exporter). Empty = off.
# GPU_METRICS_URL=http://dcgm-exporter:9400/metrics

# Management listener: serves the dashboard and the /metrics/* endpoints
# (in-flight/conversation session data — loopback by default). Point it at a
# LAN interface only when a TLS/auth reverse proxy covers that network.
# METRICS_LISTEN=127.0.0.1:9100
# Host allowlist for the management listener (DNS-rebinding guard): only requests
# whose Host header matches one of these reach the management routes; all others
# get 403. Comma-separated, loopback hosts by default. Extend to the funnel
# domain when pointing the LAN-exposed listener at a reverse proxy.
# METRICS_ALLOWED_HOSTS=127.0.0.1,::1,localhost
